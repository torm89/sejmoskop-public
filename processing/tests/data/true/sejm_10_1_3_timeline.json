        "timeline_id": 130
      },
      {
        "speaking": {
          "name": "Pose\u0142 Marek Suski"
        },
        "text": "Na posiedzeniu komisji regulaminowej...",
        "text_type": "INTERJECTION",
        "text_subtype": "NORMAL",
        "timeline_id": 131
      },
      {
        "text": "",
        "comments": [
          "Przerwa w posiedzeniu od godz. 12 min 20 do godz. 12 min 21"
        ],
        "text_type": "NORMAL",
        "timeline_id": 132
      },
      {
        "text": "Wznawiam obrady. (Weso\u0142o\u015b\u0107 na sali)",
        "comments": [
          "Weso\u0142o\u015b\u0107 na sali"
